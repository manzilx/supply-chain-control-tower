# Project Control Tower — production env template.
# Copy to .env.production, fill in real values, then:
#   docker compose --env-file .env.production up -d --build
#
# .env.production is gitignored.

# ---------------------------------------------------------------------------
# Public hostname & TLS (Caddy auto-issues Let's Encrypt for non-localhost)
# ---------------------------------------------------------------------------
HOSTNAME=control-tower.example.com
ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------------------
# CORS — restrict to your real frontend origin in production
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=https://control-tower.example.com
# Or use a regex (escape dots):
# ALLOWED_ORIGIN_REGEX=https://(www\.)?control-tower\.example\.com

# ---------------------------------------------------------------------------
# Backend runtime
# ---------------------------------------------------------------------------
APP_ENV=prod

# ---------------------------------------------------------------------------
# Auth — JWT signing secret (MANDATORY in production)
# ---------------------------------------------------------------------------
# Generate a long random string, e.g.:  openssl rand -hex 32
# The backend refuses to start in prod if this is missing or still the dev default.
JWT_SECRET=

# Keep at 1 — state lives in process-local dicts (snapshot-to-disk handles
# durability, but multi-worker would split the store and lose writes).
UVICORN_WORKERS=1
SNAPSHOT_INTERVAL_SECONDS=120

# ---------------------------------------------------------------------------
# DeepSeek — the only LLM. Missing key → deterministic templates.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# GRN photo extraction — off; deepseek-v4-flash is text-only (image parts 400).
# DEEPSEEK_VISION=0

# ---------------------------------------------------------------------------
# SAP CPI integration
# ---------------------------------------------------------------------------
SAP_CPI_MODE=mock
SAP_CPI_BASE_URL=
SAP_CPI_TOKEN_URL=
SAP_CPI_CLIENT_ID=
SAP_CPI_CLIENT_SECRET=
