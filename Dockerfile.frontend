# Project Control Tower — frontend (Next.js 14)
# Multi-stage: deps → build → runtime. Uses Next standalone output for ~50MB image.

# -------- Stage 1: deps --------
FROM node:20-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund

# -------- Stage 2: build --------
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
# NEXT_PUBLIC_* baked in at build time; default to relative /api so the
# reverse proxy handles routing in production.
ARG NEXT_PUBLIC_API_BASE=""
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
RUN npm run build

# -------- Stage 3: runtime --------
FROM node:20-alpine AS runtime
WORKDIR /app

# node:alpine already ships a non-root `node` user (uid 1000) — reuse it
# instead of creating a duplicate uid 1000.

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001 \
    HOSTNAME=0.0.0.0

# Standalone bundle: includes node_modules trace
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3001/ >/dev/null 2>&1 || exit 1

CMD ["node", "server.js"]
