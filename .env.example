# Copy this file to .env and fill in real values.
# scripts/demo.sh auto-loads .env before starting the backend + frontend.
# .env itself is gitignored.

# ---------------------------------------------------------------------------
# xAI / Grok — primary LLM for every AI feature in the app
# ---------------------------------------------------------------------------
# When XAI_API_KEY is set:
#   - /api/chat                                 → source: "grok"
#   - /api/analyze   (executive brief)          → Grok-generated
#   - /api/vendors/intel/{name}/briefing        → Grok-generated
#   - /api/risks/mitigations                    → Grok-generated
#   - /api/risk/simulate (SimulationResult.narrative)
#   - /api/weekly-plan (synthesized_narrative)
#   - /api/projects/{id}/bom/autofill           → Grok-matched
#   - /api/projects/{id}/bom/{id}/spec-request  → Grok-drafted
#   - /api/explain                              → Grok-generated
#   - Award rationales (sourcing.award_rfq)     → Grok-cited
#   - Follow-up emails (expediting)             → Grok-drafted
#
# When unset, every feature gracefully falls back to its deterministic
# template (and the response field source="deterministic" tells you so).

XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1
# Optional: leave blank to let the model decide reasoning depth.
# Set to "low" or "high" to override.
XAI_REASONING_EFFORT=

# ---------------------------------------------------------------------------
# Auth — JWT signing (local dev only; optional)
# ---------------------------------------------------------------------------
# Defaults to dev-secret-change-me for local/demo. Set explicitly if you want a
# stable secret across restarts. Production requires a unique value — see
# .env.production.example (the backend refuses the dev default when APP_ENV=prod).
# JWT_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# Server ports (defaults are fine — only override if you have conflicts)
# ---------------------------------------------------------------------------
# BACKEND_PORT=8010
# FRONTEND_PORT=3001
# ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# SAP CPI (Cloud Integration) — PR/PO submission + master-data sync
# ---------------------------------------------------------------------------
# Modes:
#   mock     — default. No network. Generates plausible SAP doc numbers so the
#              whole submit → webhook → resync loop is testable locally.
#   live     — real CPI tenant. Requires the iflows + OAuth2 credentials below.
#   disabled — every Submit-to-SAP returns failed; the button is greyed out.
SAP_CPI_MODE=mock

# Required only when SAP_CPI_MODE=live
SAP_CPI_BASE_URL=https://example-cpi.eu1.hana.ondemand.com
SAP_CPI_TOKEN_URL=https://example.authentication.eu1.hana.ondemand.com/oauth/token
SAP_CPI_CLIENT_ID=
SAP_CPI_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Legacy fallbacks (still wired but no longer used unless you flip back)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
