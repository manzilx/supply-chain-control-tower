# Copy this file to .env and fill in real values.
# scripts/demo.sh auto-loads .env before starting the backend + frontend.
# .env itself is gitignored.

# ---------------------------------------------------------------------------
# DeepSeek — the only LLM. Missing key or a failed call → deterministic templates.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GRN challan photo extraction. Off by default — deepseek-v4-flash is text-only
# and rejects image parts with HTTP 400, so photo GRNs skip extraction and go
# straight to manual keying + matching. Set to 1 only if you point
# DEEPSEEK_BASE_URL/DEEPSEEK_MODEL at a vision-capable OpenAI-compatible endpoint.
# DEEPSEEK_VISION=0

# ---------------------------------------------------------------------------
# Auth — JWT signing (local dev only; optional)
# ---------------------------------------------------------------------------
# Defaults to dev-secret-change-me for local/demo. Set explicitly if you want a
# stable secret across restarts. Production requires a unique value — see
# .env.production.example (the backend refuses the dev default when APP_ENV=prod).
# JWT_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# Server ports (defaults are fine — only override if you have conflicts)
# ---------------------------------------------------------------------------
# BACKEND_PORT=8010
# FRONTEND_PORT=3001
# ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# SAP CPI (Cloud Integration) — PR/PO submission + master-data sync
# ---------------------------------------------------------------------------
# Modes:
#   mock     — default. No network. Generates plausible SAP doc numbers so the
#              whole submit → webhook → resync loop is testable locally.
#   live     — real CPI tenant. Requires the iflows + OAuth2 credentials below.
#   disabled — every Submit-to-SAP returns failed; the button is greyed out.
SAP_CPI_MODE=mock

# Required only when SAP_CPI_MODE=live
SAP_CPI_BASE_URL=https://example-cpi.eu1.hana.ondemand.com
SAP_CPI_TOKEN_URL=https://example.authentication.eu1.hana.ondemand.com/oauth/token
SAP_CPI_CLIENT_ID=
SAP_CPI_CLIENT_SECRET=
